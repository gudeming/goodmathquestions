{
  "name": "goodmathquestions",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:questions": "tsx scripts/audit-questions.ts",
    "content-lint": "tsx scripts/content-lint.ts",
    "test:e2e": "npm run test:e2e -w @gmq/web",
    "k6": "k6 run scripts/k6/question-page.js && k6 run scripts/k6/guess-submit.js",
    "db:push": "turbo db:push --filter=@gmq/db",
    "db:generate": "turbo db:generate --filter=@gmq/db",
    "db:seed": "turbo db:seed --filter=@gmq/db",
    "start:deploy": "bash scripts/start.sh",
    "stop:deploy": "bash scripts/stop.sh"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.8.2"
}
